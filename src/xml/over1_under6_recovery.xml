            </statement>
            <statement name="ELSE">
              <block type="notify" id="freebot-o1u6-observer-wait-notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="freebot-o1u6-observer-wait-notify-text">
                    <field name="TEXT">Waiting · observer gate</field>
                  </shadow>
                </value>
              </block>
            </statement>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="notify" id="freebot-o1u6-session-wait-notify">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="freebot-o1u6-session-wait-notify-text">
                <field name="TEXT">Waiting · session guard</field>
              </shadow>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="freebot-o1u6-after-purchase" x="900" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-o1u6-ap-trades">
        <field name="VAR" id="freebot-trades" variabletype="">freebot:trades</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="freebot-o1u6-ap-trades-add">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="freebot-o1u6-ap-read-trades">
                <field name="VAR" id="freebot-trades" variabletype="">freebot:trades</field>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-o1u6-ap-won">
            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
            <value name="VALUE">
              <block type="contract_check_result" id="freebot-o1u6-ap-check-win">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-o1u6-ap-profit">
                <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="freebot-o1u6-ap-profit-sum">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-o1u6-ap-read-profit">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="read_details" id="freebot-o1u6-ap-contract-profit">
                        <field name="DETAIL_INDEX">4</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="freebot-o1u6-ap-take-profit">
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-o1u6-ap-tp-compare">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-o1u6-ap-read-profit-tp">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number"><field name="NUM">20</field></shadow>
                          <block type="variables_get" id="freebot-o1u6-ap-tp-read">
                            <field name="VAR" id="freebot-take-profit" variabletype="">freebot:take-profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="freebot-o1u6-ap-stop-on-profit">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-o1u6-ap-bool-tp">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-o1u6-ap-stop-loss">
                        <value name="IF0">
                          <block type="logic_compare" id="freebot-o1u6-ap-sl-compare">
                            <field name="OP">LTE</field>
                            <value name="A">
                              <block type="variables_get" id="freebot-o1u6-ap-read-profit-sl">
                                <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number"><field name="NUM">-50</field></shadow>
                              <block type="variables_get" id="freebot-o1u6-ap-sl-read">
                                <field name="VAR" id="freebot-stop-loss" variabletype="">freebot:stop-loss</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-o1u6-ap-stop-on-loss">
                            <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="freebot-o1u6-ap-bool-sl">
                                <field name="BOOL">TRUE</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-o1u6-ap-loss-count"><mutation else="1"></mutation>
                            <value name="IF0">
                              <block type="variables_get" id="freebot-o1u6-ap-read-won">
                                <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="freebot-o1u6-ap-reset-stake">
                                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                <value name="VALUE">
                                  <block type="math_number" id="freebot-o1u6-ap-num-stake">
                                    <field name="NUM">10</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="freebot-o1u6-ap-reset-loss-count">
                                    <field name="VAR" id="freebot-loss-count" variabletype="">freebot:loss-count</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="freebot-o1u6-ap-num-zero">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <statement name="ELSE">
                              <block type="variables_set" id="freebot-o1u6-ap-multiply-stake">
                                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic" id="freebot-o1u6-ap-stake-multiplier">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="variables_get" id="freebot-o1u6-ap-read-stake">
                                        <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="math_number"><field name="NUM">2</field></shadow>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="freebot-o1u6-ap-add-loss-count">
                                    <field name="VAR" id="freebot-loss-count" variabletype="">freebot:loss-count</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic" id="freebot-o1u6-ap-loss-count-sum">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get" id="freebot-o1u6-ap-read-loss-count">
                                            <field name="VAR" id="freebot-loss-count" variabletype="">freebot:loss-count</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number"><field name="NUM">1</field></shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if" id="freebot-o1u6-ap-trade-again">
                                <value name="IF0">
                                  <block type="logic_negate" id="freebot-o1u6-ap-not-stopped">
                                    <value name="BOOL">
                                      <block type="variables_get" id="freebot-o1u6-ap-read-stop">
                                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                    <block type="report_journal" id="freebot-o1u6-result-report">
                                      <field name="LEVEL">info</field>
                                      <value name="MESSAGE">
                                        <shadow type="text" id="freebot-o1u6-result-report-text">
                                          <field name="TEXT">Result</field>
                                        </shadow>
                                        <block type="exec_last_result" id="freebot-o1u6-result-report-value"></block>
                                      </value>
                                      <next>
                                        <block type="report_journal" id="freebot-o1u6-session-report">
                                          <field name="LEVEL">info</field>
                                          <value name="MESSAGE">
                                            <shadow type="text" id="freebot-o1u6-session-report-text">
                                              <field name="TEXT">Session report</field>
                                            </shadow>
                                            <block type="report_session" id="freebot-o1u6-session-report-value"></block>
                                          </value>
                                          <next>
                                            <block type="trade_again" id="freebot-o1u6-trade-again"></block>
                                          </next>
                                        </block>
                                      </next>
                                    </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
