<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-notice" islocal="false" iscloud="false">freebot:notice</variable>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-market-scanned" islocal="false" iscloud="false">freebot:market-scanned</variable>
  </variables>
  <block type="trade_definition" id="freebot-pr-definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-pr-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-pr-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-pr-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-pr-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-pr-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-pr-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="controls_if" id="freebot-pr-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-pr-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-pr-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-pr-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-pr-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-pr-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-pr-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-pr-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-pr-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-pr-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-pr-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                        <next>
                          <block type="eo_configure" id="freebot-pr-configure">
                            <field name="TICKS">20</field>
                            <field name="PERCENT">65</field>
                            <field name="DIRECTION">both</field>
                            <next>
                              <block type="eo_monitor_ticks" id="freebot-pr-monitor">
                                <value name="TICKS">
                                  <shadow type="math_number" id="freebot-pr-monitor-window">
                                    <field name="NUM">20</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="eo_one_entry_per_signal" id="freebot-pr-one-entry">
                                    <next>
                                      <block type="risk_set_limits" id="freebot-pr-risk-limits">
                                        <field name="MAX_LOSSES">6</field>
                                        <field name="MAX_GIVE_BACK">0</field>
                                        <field name="MAX_EXPOSURE">0</field>
                                        <field name="RISK_PERCENT">0</field>
                                        <next>
                                          <block type="risk_reset_session" id="freebot-pr-risk-reset">
                                            <next>
                                              <block type="learn_set_strategy" id="freebot-pr-learn-strategy">
                                                <field name="NAME">Over 1 — Even/Odd Recovery</field>
                                                <next>
                                                  <block type="market_discover_eligible" id="freebot-pr-market-discover">
                                                    <field name="CATEGORY">1-Second Volatility Indices</field>
                                                    <field name="VERIFY">no</field>
                                                    <value name="MIN_HISTORY">
                                                      <shadow type="math_number" id="freebot-pr-market-history">
                                                        <field name="NUM">20</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-pr-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-pr-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-pr-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-pr-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-pr-before-purchase" x="0" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-pr-session-guard"><mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="freebot-pr-session-guard-and">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="risk_can_trade" id="freebot-pr-risk-guard"></block>
                </value>
                <value name="B">
                  <block type="logic_operation" id="freebot-pr-session-guard-execution">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_negate" id="freebot-pr-no-open-contract">
                        <value name="BOOL">
                          <block type="exec_has_open_contract" id="freebot-pr-open-contract"></block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_negate" id="freebot-pr-trade-limit-ok">
                        <value name="BOOL">
                          <block type="bot_trade_limit_reached" id="freebot-pr-trade-limit">
                            <value name="LIMIT">
                              <shadow type="math_number" id="freebot-pr-trade-limit-value">
                                <field name="NUM">250</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="freebot-pr-observer-gate"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="obs_and" id="freebot-pr-observer-and">
                    <value name="A">
                      <block type="obs_min_sample" id="freebot-pr-window-sample">
                        <field name="N">20</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="obs_and" id="freebot-pr-observer-monitor">
                        <value name="A">
                          <block type="obs_and" id="freebot-pr-observer-data">
                            <value name="A">
                              <block type="obs_fresh" id="freebot-pr-observer-fresh"></block>
                            </value>
                            <value name="B">
                              <block type="obs_require_sample" id="freebot-pr-observer-entry-sample">
                                <field name="N">20</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="obs_parity_switched" id="freebot-pr-observer-parity"></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
            <block type="digits_parity_recovery" id="freebot-pr-parity-recovery-entry">
                <field name="PRIMARY">over_1</field>
                <field name="PARITY">both</field>
                <field name="TICKS">100</field>
                <field name="PERCENT">55</field>
              </block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="freebot-pr-observer-wait-notify">
                    <field name="NOTIFICATION_TYPE">info</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="freebot-pr-observer-wait-notify-text">
                        <field name="TEXT">Waiting · observer gate</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="freebot-pr-session-wait-notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="freebot-pr-session-wait-notify-text">
                    <field name="TEXT">Waiting · session guard</field>
                  </shadow>
                </value>
              </block>
            </statement>
          </block>
        
    </statement>
  </block>
  <block type="after_purchase" id="freebot-pr-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-pr-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-pr-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-pr-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-pr-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-pr-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-pr-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="freebot-pr-take-profit"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="freebot-pr-take-profit-compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-pr-read-profit-for-tp">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="freebot-pr-take-profit-value">
                        <field name="NUM">10</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="freebot-pr-stop-on-profit">
                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="freebot-pr-stop-on-profit-value">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="freebot-pr-stop-loss"><mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-pr-stop-loss-compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-pr-read-profit-for-sl">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="freebot-pr-stop-loss-value">
                            <field name="NUM">-20</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="freebot-pr-stop-on-loss">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-pr-stop-on-loss-value">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-pr-stake-step">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="variables_get" id="freebot-pr-read-won">
                            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-pr-reset-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_number" id="freebot-pr-reset-stake-value">
                                <field name="NUM">10</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="freebot-pr-multiply-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="freebot-pr-stake-multiplier">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-pr-read-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-pr-multiplier-value">
                                    <field name="NUM">1.5</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-pr-rescan-after-loss">
                                <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="freebot-pr-rescan-after-loss-value">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-pr-trade-again">
                            <value name="IF0">
                              <block type="logic_negate" id="freebot-pr-not-stopped">
                                <value name="BOOL">
                                  <block type="variables_get" id="freebot-pr-read-stop">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                                <block type="report_journal" id="freebot-pr-result-report">
                                  <field name="LEVEL">info</field>
                                  <value name="MESSAGE">
                                    <shadow type="text" id="freebot-pr-result-report-text">
                                      <field name="TEXT">Result</field>
                                    </shadow>
                                    <block type="exec_last_result" id="freebot-pr-result-report-value"></block>
                                  </value>
                                  <next>
                                    <block type="report_journal" id="freebot-pr-session-report">
                                      <field name="LEVEL">info</field>
                                      <value name="MESSAGE">
                                        <shadow type="text" id="freebot-pr-session-report-text">
                                          <field name="TEXT">Session report</field>
                                        </shadow>
                                        <block type="report_session" id="freebot-pr-session-report-value"></block>
                                      </value>
                                      <next>
                                        <block type="trade_again" id="freebot-pr-trade-again-block"></block>
                                      </next>
                                    </block>
                                  </next>
                                </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
