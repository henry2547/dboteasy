<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-notice" islocal="false" iscloud="false">freebot:notice</variable>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
  </variables>
  <block type="trade_definition" id="obs-o2-definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="obs-o2-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="obs-o2-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="obs-o2-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="obs-o2-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="obs-o2-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="obs-o2-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="obs-o2-set-stake">
        <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
        <value name="VALUE">
          <block type="math_number" id="obs-o2-base-stake">
            <field name="NUM">10</field>
          </block>
        </value>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="obs-o2-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="AMOUNT_LIMITS"></field>
        <value name="DURATION">
          <shadow type="math_number" id="obs-o2-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="obs-o2-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="obs-o2-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number" id="obs-o2-prediction">
            <field name="NUM">2</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="obs-o2-before-purchase" x="0" y="740">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="text_join" id="obs-o2-notice">
        <field name="VARIABLE" id="freebot-notice" variabletype="">freebot:notice</field>
        <statement name="STACK">
          <block type="text_statement" id="obs-o2-notice-lead">
            <value name="TEXT">
              <shadow type="text" id="obs-o2-notice-lead-shadow">
                <field name="TEXT">Observation · latest digit </field>
              </shadow>
            </value>
            <next>
              <block type="text_statement" id="obs-o2-notice-digit">
                <value name="TEXT">
                  <shadow type="text" id="obs-o2-notice-digit-shadow">
                    <field name="TEXT">-</field>
                  </shadow>
                  <block type="obs_latest" id="obs-o2-latest-digit">
                  </block>
                </value>
                <next>
                  <block type="text_statement" id="obs-o2-notice-stage-lead">
                    <value name="TEXT">
                      <shadow type="text" id="obs-o2-notice-stage-lead-shadow">
                        <field name="TEXT"> · pattern stage </field>
                      </shadow>
                    </value>
                    <next>
                      <block type="text_statement" id="obs-o2-notice-stage">
                        <value name="TEXT">
                          <shadow type="text" id="obs-o2-notice-stage-shadow">
                            <field name="TEXT">-</field>
                          </shadow>
                          <block type="obs_pattern_stage" id="obs-o2-pattern-stage">
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="notify" id="obs-o2-notify">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="obs-o2-notify-shadow">
                <field name="TEXT">Observation</field>
              </shadow>
              <block type="variables_get" id="obs-o2-notice-read">
                <field name="VAR" id="freebot-notice" variabletype="">freebot:notice</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="obs_on_start" id="obs-o2-on-start" x="0" y="980">
    <statement name="DO">
      <block type="obs_analyse_window" id="obs-o2-window">
        <field name="N">100</field>
        <next>
          <block type="obs_set_barrier" id="obs-o2-barrier">
            <field name="BARRIER">2</field>
            <next>
              <block type="obs_configure_over" id="obs-o2-configure">
                <next>
                  <block type="obs_prevent_duplicate" id="obs-o2-dedupe">
                    <next>
                      <block type="obs_note" id="obs-o2-start-note">
                        <field name="TEXT">Watch rule · two identical digits, then observe the next tick against Over 2 · 100-tick window</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="obs_on_tick" id="obs-o2-on-tick" x="0" y="1260">
    <statement name="DO">
      <block type="obs_detect_run" id="obs-o2-detect">
        <field name="KIND">Identical digits</field>
        <field name="N">2</field>
        <next>
          <block type="obs_entry" id="obs-o2-entry">
            <value name="CONDITION">
              <block type="obs_and" id="obs-o2-entry-and">
                <value name="A">
                  <block type="obs_and" id="obs-o2-entry-pattern">
                    <value name="A">
                      <block type="obs_confirmation_after" id="obs-o2-confirmed">
                      </block>
                    </value>
                    <value name="B">
                      <block type="obs_require_sample" id="obs-o2-sample">
                        <field name="N">100</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="obs_and" id="obs-o2-freq-and-2">
                    <value name="A">
                      <block type="obs_and" id="obs-o2-freq-and-1">
                        <value name="A">
                          <block type="obs_freq_below" id="obs-o2-freq-0">
                            <field name="DIGIT">0</field>
                            <field name="PERCENT">10.3</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="obs_freq_below" id="obs-o2-freq-1">
                            <field name="DIGIT">1</field>
                            <field name="PERCENT">10.3</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="obs_freq_below" id="obs-o2-freq-2">
                        <field name="DIGIT">2</field>
                        <field name="PERCENT">10.3</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO">
              <block type="obs_note" id="obs-o2-signal-note">
                <field name="TEXT">Signal · pair confirmed · observing the next tick for Over 2</field>
                <next>
                  <block type="obs_evaluate_over" id="obs-o2-evaluate">
                    <next>
                      <block type="obs_cooldown_ticks" id="obs-o2-cooldown">
                        <field name="N">2</field>
                        <next>
                          <block type="obs_reset_pattern" id="obs-o2-reset">
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="obs_on_window" id="obs-o2-on-window" x="0" y="1700">
    <statement name="DO">
      <block type="obs_research_rank" id="obs-o2-rank">
        <field name="MINIMUM">5</field>
      </block>
    </statement>
  </block>
</xml>
