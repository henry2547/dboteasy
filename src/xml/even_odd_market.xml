<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-eo-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-eo-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-eo-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-eo-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-eo-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-eo-take-profit" islocal="false" iscloud="false">freebot:take-profit</variable>
    <variable type="" id="freebot-eo-stop-loss" islocal="false" iscloud="false">freebot:stop-loss</variable>
  </variables>
  <block type="trade_definition" id="freebot-eo-definition" x="0" y="0">
    <field name="MODE_LIST">CONTINUOUS</field>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-eo-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-eo-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-eo-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-eo-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-eo-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-eo-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="freebot-eo-init-flag">
        <field name="VAR" id="freebot-eo-initialised" variabletype="">freebot:initialised</field>
        <value name="VALUE"><block type="logic_boolean" id="freebot-eo-init-true"><field name="BOOL">TRUE</field></block></value>
        <next>
          <block type="variables_set" id="freebot-eo-init-stake">
            <field name="VAR" id="freebot-eo-stake" variabletype="">freebot:stake</field>
            <value name="VALUE"><block type="math_number" id="freebot-eo-base-stake"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="freebot-eo-init-profit">
                <field name="VAR" id="freebot-eo-profit" variabletype="">freebot:profit</field>
                <value name="VALUE"><block type="math_number" id="freebot-eo-zero-profit"><field name="NUM">0</field></block></value>
                <next>
                  <block type="variables_set" id="freebot-eo-init-stop">
                    <field name="VAR" id="freebot-eo-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE"><block type="logic_boolean" id="freebot-eo-stop-false"><field name="BOOL">FALSE</field></block></value>
                    <next>
                      <block type="variables_set" id="freebot-eo-init-tp">
                        <field name="VAR" id="freebot-eo-take-profit" variabletype="">freebot:take-profit</field>
                        <value name="VALUE"><block type="math_number" id="freebot-eo-tp-value"><field name="NUM">10</field></block></value>
                        <next>
                          <block type="variables_set" id="freebot-eo-init-sl">
                            <field name="VAR" id="freebot-eo-stop-loss" variabletype="">freebot:stop-loss</field>
                            <value name="VALUE"><block type="math_number" id="freebot-eo-sl-value"><field name="NUM">-10</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-eo-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION"><shadow type="math_number_positive" id="freebot-eo-duration"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-eo-amount-shadow"><field name="NUM">1</field></shadow>
          <block type="variables_get" id="freebot-eo-amount"><field name="VAR" id="freebot-eo-stake" variabletype="">freebot:stake</field></block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-eo-before-purchase" x="0" y="700">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-eo-entry-guard"><mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="freebot-eo-guards-and">
            <field name="OP">AND</field>
            <value name="A"><block type="risk_can_trade" id="freebot-eo-risk-can-trade"></block></value>
            <value name="B">
              <block type="logic_operation" id="freebot-eo-position-limit-and">
                <field name="OP">AND</field>
                <value name="A"><block type="logic_negate" id="freebot-eo-no-open-contract"><value name="BOOL"><block type="exec_has_open_contract" id="freebot-eo-open-contract"></block></value></block></value>
                <value name="B"><block type="logic_negate" id="freebot-eo-trade-cap-not-reached"><value name="BOOL"><block type="bot_trade_limit_reached" id="freebot-eo-trade-cap"><value name="LIMIT"><shadow type="math_number"><field name="NUM">100</field></shadow></value></block></value></block></value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0"><block type="eo_journal_reverse" id="freebot-eo-last-digits"><field name="RUN">2</field></block></statement>
        <statement name="ELSE"><block type="report_journal" id="freebot-eo-wait-log"><field name="LEVEL">info</field><value name="MESSAGE"><shadow type="text"><field name="TEXT">Even/Odd entry waiting: risk, open-contract or trade limit guard</field></shadow></value></block></statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="freebot-eo-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-eo-save-won">
        <field name="VAR" id="freebot-eo-won" variabletype="">freebot:won</field>
        <value name="VALUE"><block type="contract_check_result" id="freebot-eo-check-win"><field name="CHECK_RESULT">win</field></block></value>
        <next>
          <block type="variables_set" id="freebot-eo-add-profit">
            <field name="VAR" id="freebot-eo-profit" variabletype="">freebot:profit</field>
            <value name="VALUE"><block type="math_arithmetic" id="freebot-eo-profit-sum"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="freebot-eo-read-profit"><field name="VAR" id="freebot-eo-profit" variabletype="">freebot:profit</field></block></value><value name="B"><block type="read_details" id="freebot-eo-contract-profit"><field name="DETAIL_INDEX">4</field></block></value></block></value>
            <next>
              <block type="controls_if" id="freebot-eo-take-profit"><mutation else="1"></mutation>
                <value name="IF0"><block type="logic_compare" id="freebot-eo-tp-check"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="freebot-eo-profit-for-tp"><field name="VAR" id="freebot-eo-profit" variabletype="">freebot:profit</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">10</field></shadow><block type="variables_get" id="freebot-eo-tp-limit"><field name="VAR" id="freebot-eo-take-profit" variabletype="">freebot:take-profit</field></block></value></block></value>
                <statement name="DO0"><block type="sweet_alert" id="freebot-eo-tp-alert"><field name="ALERT_ICON">success</field><value name="TITLE"><shadow type="text"><field name="TEXT">Take profit reached</field></shadow></value><value name="MESSAGE"><shadow type="text"><field name="TEXT">Even/Odd bot stopped at its +10 profit limit.</field></shadow></value><next><block type="variables_set" id="freebot-eo-stop-at-tp"><field name="VAR" id="freebot-eo-stop" variabletype="">freebot:stop</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value></block></next></block></statement>
                <next>
                  <block type="controls_if" id="freebot-eo-stop-loss"><mutation else="1"></mutation>
                    <value name="IF0"><block type="logic_compare" id="freebot-eo-sl-check"><field name="OP">LTE</field><value name="A"><block type="variables_get" id="freebot-eo-profit-for-sl"><field name="VAR" id="freebot-eo-profit" variabletype="">freebot:profit</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">-10</field></shadow><block type="variables_get" id="freebot-eo-sl-limit"><field name="VAR" id="freebot-eo-stop-loss" variabletype="">freebot:stop-loss</field></block></value></block></value>
                    <statement name="DO0"><block type="sweet_alert" id="freebot-eo-sl-alert"><field name="ALERT_ICON">error</field><value name="TITLE"><shadow type="text"><field name="TEXT">Stop loss reached</field></shadow></value><value name="MESSAGE"><shadow type="text"><field name="TEXT">Even/Odd bot stopped at its −10 loss limit.</field></shadow></value><next><block type="variables_set" id="freebot-eo-stop-at-sl"><field name="VAR" id="freebot-eo-stop" variabletype="">freebot:stop</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value></block></next></block></statement>
                    <next>
                      <block type="controls_if" id="freebot-eo-stake-reset"><mutation else="1"></mutation>
                        <value name="IF0"><block type="variables_get" id="freebot-eo-won-read"><field name="VAR" id="freebot-eo-won" variabletype="">freebot:won</field></block></value>
                        <statement name="DO0"><block type="variables_set" id="freebot-eo-reset-stake"><field name="VAR" id="freebot-eo-stake" variabletype="">freebot:stake</field><value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
                        <statement name="ELSE"><block type="report_journal" id="freebot-eo-loss-stake-log"><field name="LEVEL">warn</field><value name="MESSAGE"><shadow type="text"><field name="TEXT">Loss recorded; stake remains flat at 1 USD. No martingale is used.</field></shadow></value></block></statement>
                        <next>
                          <block type="controls_if" id="freebot-eo-trade-again"><value name="IF0"><block type="logic_negate" id="freebot-eo-not-stopped"><value name="BOOL"><block type="variables_get" id="freebot-eo-read-stop"><field name="VAR" id="freebot-eo-stop" variabletype="">freebot:stop</field></block></value></block></value><statement name="DO0"><block type="report_journal" id="freebot-eo-result-log"><field name="LEVEL">info</field><value name="MESSAGE"><shadow type="text"><field name="TEXT">Even/Odd settlement recorded; waiting for the next eligible same-parity run.</field></shadow></value><next><block type="trade_again" id="freebot-eo-trade-again-block"></block></next></block></statement></block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
