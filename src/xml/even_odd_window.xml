<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-notice" islocal="false" iscloud="false">freebot:notice</variable>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-market-scanned" islocal="false" iscloud="false">freebot:market-scanned</variable>
  </variables>
  <block type="trade_definition" id="freebot-eo-definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-eo-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-eo-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-eo-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-eo-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-eo-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-eo-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="controls_if" id="freebot-eo-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-eo-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-eo-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-eo-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-eo-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-eo-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-eo-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-eo-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-eo-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-eo-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-eo-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                        <next>
                          <block type="eo_configure" id="freebot-eo-configure">
                            <field name="TICKS">20</field>
                            <field name="PERCENT">65</field>
                            <field name="DIRECTION">both</field>
                            <next>
                              <block type="eo_monitor_ticks" id="freebot-eo-monitor">
                                <value name="TICKS">
                                  <shadow type="math_number" id="freebot-eo-monitor-window">
                                    <field name="NUM">20</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="eo_one_entry_per_signal" id="freebot-eo-one-entry">
                                    <next>
                                      <block type="risk_set_limits" id="freebot-eo-risk-limits">
                                        <field name="MAX_LOSSES">6</field>
                                        <field name="MAX_GIVE_BACK">0</field>
                                        <field name="MAX_EXPOSURE">0</field>
                                        <field name="RISK_PERCENT">0</field>
                                        <next>
                                          <block type="risk_reset_session" id="freebot-eo-risk-reset">
                                            <next>
                                              <block type="learn_set_strategy" id="freebot-eo-learn-strategy">
                                                <field name="NAME">Even / Odd — Best Volatility Market</field>
                                                <next>
                                                  <block type="market_discover_eligible" id="freebot-eo-market-discover">
                                                    <field name="CATEGORY">1-Second Volatility Indices</field>
                                                    <field name="VERIFY">no</field>
                                                    <value name="MIN_HISTORY">
                                                      <shadow type="math_number" id="freebot-eo-market-history">
                                                        <field name="NUM">20</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-eo-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-eo-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-eo-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-eo-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-eo-before-purchase" x="0" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-eo-market-pick">
        <value name="IF0">
          <block type="logic_negate" id="freebot-eo-market-pick-not-scanned">
            <value name="BOOL">
              <block type="variables_get" id="freebot-eo-market-pick-read-scanned">
                <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-eo-market-pick-set-scanned">
            <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-eo-market-pick-scanned-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="switch_best_parity_market" id="freebot-eo-market-pick-scan">
                <value name="TICKS">
                  <shadow type="math_number" id="freebot-eo-market-pick-ticks">
                    <field name="NUM">100</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="freebot-eo-session-guard"><mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="freebot-eo-session-guard-and">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="risk_can_trade" id="freebot-eo-risk-guard"></block>
                </value>
                <value name="B">
                  <block type="logic_operation" id="freebot-eo-session-guard-execution">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_negate" id="freebot-eo-no-open-contract">
                        <value name="BOOL">
                          <block type="exec_has_open_contract" id="freebot-eo-open-contract"></block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_negate" id="freebot-eo-trade-limit-ok">
                        <value name="BOOL">
                          <block type="bot_trade_limit_reached" id="freebot-eo-trade-limit">
                            <value name="LIMIT">
                              <shadow type="math_number" id="freebot-eo-trade-limit-value">
                                <field name="NUM">250</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="freebot-eo-observer-gate"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="obs_and" id="freebot-eo-observer-and">
                    <value name="A">
                      <block type="obs_min_sample" id="freebot-eo-window-sample">
                        <field name="N">20</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="obs_and" id="freebot-eo-observer-monitor">
                        <value name="A">
                          <block type="obs_and" id="freebot-eo-observer-data">
                            <value name="A">
                              <block type="obs_fresh" id="freebot-eo-observer-fresh"></block>
                            </value>
                            <value name="B">
                              <block type="obs_require_sample" id="freebot-eo-observer-entry-sample">
                                <field name="N">20</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="obs_parity_switched" id="freebot-eo-observer-parity"></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
            <block type="controls_if" id="freebot-eo-entry"><mutation else="1"></mutation>
              <value name="IF0">
                <block type="logic_compare" id="freebot-eo-entry-even">
                  <field name="OP">EQ</field>
                  <value name="A">
                    <block type="eo_signal_direction" id="freebot-eo-entry-even-signal"></block>
                  </value>
                  <value name="B">
                    <shadow type="text" id="freebot-eo-entry-even-text">
                      <field name="TEXT">EVEN</field>
                    </shadow>
                  </value>
                </block>
              </value>
              <statement name="DO0">
                <block type="eo_buy_even" id="freebot-eo-buy-even"></block>
              </statement>
              <statement name="ELSE">
                <block type="controls_if" id="freebot-eo-entry-odd"><mutation else="1"></mutation>
                  <value name="IF0">
                    <block type="logic_compare" id="freebot-eo-entry-odd-compare">
                      <field name="OP">EQ</field>
                      <value name="A">
                        <block type="eo_signal_direction" id="freebot-eo-entry-odd-signal"></block>
                      </value>
                      <value name="B">
                        <shadow type="text" id="freebot-eo-entry-odd-text">
                          <field name="TEXT">ODD</field>
                        </shadow>
                      </value>
                    </block>
                  </value>
                  <statement name="DO0">
                    <block type="eo_buy_odd" id="freebot-eo-buy-odd"></block>
                  </statement>
                  <statement name="ELSE">
                    <block type="text_join" id="freebot-eo-entry-wait-notice">
                      <field name="VARIABLE" id="freebot-notice" variabletype="">freebot:notice</field>
                      <statement name="STACK">
                        <block type="text_statement" id="freebot-eo-entry-wait-notice-label">
                          <value name="TEXT">
                            <shadow type="text" id="freebot-eo-entry-wait-notice-label-text">
                              <field name="TEXT">Waiting · signal</field>
                            </shadow>
                          </value>
                          <next>
                            <block type="text_statement" id="freebot-eo-entry-wait-notice-signal">
                              <value name="TEXT">
                                <shadow type="text" id="freebot-eo-entry-wait-notice-signal-text">
                                  <field name="TEXT"></field>
                                </shadow>
                                <block type="eo_signal_direction" id="freebot-eo-entry-wait-notice-signal-block"></block>
                              </value>
                            </block>
                          </next>
                        </block>
                      </statement>
                      <next>
                        <block type="notify" id="freebot-eo-entry-wait-notify">
                          <field name="NOTIFICATION_TYPE">info</field>
                          <field name="NOTIFICATION_SOUND">silent</field>
                          <value name="MESSAGE">
                            <shadow type="text" id="freebot-eo-entry-wait-notify-text">
                              <field name="TEXT">Waiting · signal</field>
                            </shadow>
                            <block type="variables_get" id="freebot-eo-entry-wait-notify-read">
                              <field name="VAR" id="freebot-notice" variabletype="">freebot:notice</field>
                            </block>
                          </value>
                        </block>
                      </next>
                    </block>
                  </statement>
                </block>
              </statement>
            </block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="freebot-eo-observer-wait-notify">
                    <field name="NOTIFICATION_TYPE">info</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="freebot-eo-observer-wait-notify-text">
                        <field name="TEXT">Waiting · observer gate</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="freebot-eo-session-wait-notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="freebot-eo-session-wait-notify-text">
                    <field name="TEXT">Waiting · session guard</field>
                  </shadow>
                </value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="freebot-eo-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-eo-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-eo-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-eo-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-eo-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-eo-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-eo-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="freebot-eo-take-profit"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="freebot-eo-take-profit-compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-eo-read-profit-for-tp">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="freebot-eo-take-profit-value">
                        <field name="NUM">10</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="freebot-eo-stop-on-profit">
                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="freebot-eo-stop-on-profit-value">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="freebot-eo-stop-loss"><mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-eo-stop-loss-compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-eo-read-profit-for-sl">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="freebot-eo-stop-loss-value">
                            <field name="NUM">-20</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="freebot-eo-stop-on-loss">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-eo-stop-on-loss-value">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-eo-stake-step">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="variables_get" id="freebot-eo-read-won">
                            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-eo-reset-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_number" id="freebot-eo-reset-stake-value">
                                <field name="NUM">10</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="freebot-eo-multiply-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="freebot-eo-stake-multiplier">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-eo-read-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-eo-multiplier-value">
                                    <field name="NUM">1.5</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-eo-rescan-after-loss">
                                <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="freebot-eo-rescan-after-loss-value">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-eo-trade-again">
                            <value name="IF0">
                              <block type="logic_negate" id="freebot-eo-not-stopped">
                                <value name="BOOL">
                                  <block type="variables_get" id="freebot-eo-read-stop">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="trade_again" id="freebot-eo-trade-again-block">
                                <next>
                                  <block type="report_journal" id="freebot-eo-result-report">
                                    <field name="LEVEL">info</field>
                                    <value name="MESSAGE">
                                      <shadow type="text" id="freebot-eo-result-report-text">
                                        <field name="TEXT">Result</field>
                                      </shadow>
                                      <block type="exec_last_result" id="freebot-eo-result-report-value"></block>
                                    </value>
                                    <next>
                                      <block type="report_journal" id="freebot-eo-session-report">
                                        <field name="LEVEL">info</field>
                                        <value name="MESSAGE">
                                          <shadow type="text" id="freebot-eo-session-report-text">
                                            <field name="TEXT">Session report</field>
                                          </shadow>
                                          <block type="report_session" id="freebot-eo-session-report-value"></block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
