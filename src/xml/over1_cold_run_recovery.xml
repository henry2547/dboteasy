<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-notice" islocal="false" iscloud="false">freebot:notice</variable>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-market-scanned" islocal="false" iscloud="false">freebot:market-scanned</variable>
    <variable type="" id="freebot-take-profit" islocal="false" iscloud="false">freebot:take-profit</variable>
    <variable type="" id="freebot-stop-loss" islocal="false" iscloud="false">freebot:stop-loss</variable>
    <variable type="" id="freebot-reset-stake" islocal="false" iscloud="false">freebot:reset-stake</variable>
    <variable type="" id="freebot-multiplier" islocal="false" iscloud="false">freebot:multiplier</variable>
  </variables>
  <block type="trade_definition" id="freebot-o1cr-definition" x="0" y="0">
    <field name="MODE_LIST">CONTINUOUS</field>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-o1cr-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-o1cr-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-o1cr-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-o1cr-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-o1cr-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-o1cr-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="controls_if" id="freebot-o1cr-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-o1cr-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-o1cr-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-o1cr-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-o1cr-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-o1cr-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-o1cr-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-o1cr-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-o1cr-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-o1cr-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-o1cr-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="freebot-o1cr-set-take-profit"><field name="VAR" id="freebot-take-profit" variabletype="">freebot:take-profit</field><value name="VALUE"><block type="math_number" id="freebot-o1cr-num-take-profit"><field name="NUM">10</field></block></value><next><block type="variables_set" id="freebot-o1cr-set-stop-loss"><field name="VAR" id="freebot-stop-loss" variabletype="">freebot:stop-loss</field><value name="VALUE"><block type="math_number" id="freebot-o1cr-num-stop-loss"><field name="NUM">-20</field></block></value><next><block type="variables_set" id="freebot-o1cr-set-reset-stake"><field name="VAR" id="freebot-reset-stake" variabletype="">freebot:reset-stake</field><value name="VALUE"><block type="math_number" id="freebot-o1cr-num-reset-stake"><field name="NUM">10</field></block></value><next><block type="variables_set" id="freebot-o1cr-set-multiplier"><field name="VAR" id="freebot-multiplier" variabletype="">freebot:multiplier</field><value name="VALUE"><block type="math_number" id="freebot-o1cr-num-multiplier"><field name="NUM">1.5</field></block></value><next><block type="variables_set" id="freebot-o1cr-set-market-scanned"><field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field><value name="VALUE"><block type="logic_boolean" id="freebot-o1cr-market-scanned-value"><field name="BOOL">FALSE</field></block></value><next><block type="risk_set_limits" id="freebot-o1cr-risk-limits">
                            <field name="MAX_LOSSES">6</field>
                            <field name="MAX_GIVE_BACK">0</field>
                            <field name="MAX_EXPOSURE">0</field>
                            <field name="RISK_PERCENT">0</field>
                            <next>
                              <block type="risk_reset_session" id="freebot-o1cr-risk-reset">
                                <next>
                                  <block type="learn_set_strategy" id="freebot-o1cr-learn-strategy">
                                    <field name="NAME">Over 1 — Confirmed 0/1 Pair</field>
                                    <next>
                                      <block type="market_discover_eligible" id="freebot-o1cr-market-discover">
                                        <field name="CATEGORY">1-Second Volatility Indices</field>
                                        <field name="VERIFY">no</field>
                                        <value name="MIN_HISTORY">
                                          <shadow type="math_number" id="freebot-o1cr-market-history">
                                            <field name="NUM">20</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block></next></block></next></block></next></block></next></block></next></block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-o1cr-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-o1cr-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-o1cr-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-o1cr-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-o1cr-before-purchase" x="0" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-o1cr-frequency-limit"><mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="freebot-o1cr-frequency-limit-any">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_compare" id="freebot-o1cr-frequency-limit-0">
        <field name="OP">GT</field>
        <value name="A">
          <block type="digits_frequency" id="freebot-o1cr-frequency-0">
            <field name="DIGIT">0</field>
            <value name="SAMPLE">
              <shadow type="math_number" id="freebot-o1cr-frequency-0-sample">
                <field name="NUM">1000</field>
              </shadow>
            </value>
          </block>
        </value>
        <value name="B">
          <shadow type="math_number" id="freebot-o1cr-frequency-limit-0-max">
            <field name="NUM">10.2</field>
          </shadow>
        </value>
      </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="freebot-o1cr-frequency-limit-1">
        <field name="OP">GT</field>
        <value name="A">
          <block type="digits_frequency" id="freebot-o1cr-frequency-1">
            <field name="DIGIT">1</field>
            <value name="SAMPLE">
              <shadow type="math_number" id="freebot-o1cr-frequency-1-sample">
                <field name="NUM">1000</field>
              </shadow>
            </value>
          </block>
        </value>
        <value name="B">
          <shadow type="math_number" id="freebot-o1cr-frequency-limit-1-max">
            <field name="NUM">10.2</field>
          </shadow>
        </value>
      </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="bot_stop" id="freebot-o1cr-frequency-stop">
            <value name="REASON">
              <shadow type="text" id="freebot-o1cr-frequency-stop-reason">
                <field name="TEXT">Over 1 stopped: digit 0 or 1 is above 10.2% of the last 1000 ticks</field>
              </shadow>
            </value>
          </block>
        </statement>
      <statement name="ELSE">
<block type="controls_if" id="freebot-o1cr-session-guard"><mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="freebot-o1cr-session-guard-and">
            <field name="OP">AND</field>
            <value name="A">
              <block type="risk_can_trade" id="freebot-o1cr-risk-guard"></block>
            </value>
            <value name="B">
              <block type="logic_operation" id="freebot-o1cr-session-guard-execution">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_negate" id="freebot-o1cr-no-open-contract">
                    <value name="BOOL">
                      <block type="exec_has_open_contract" id="freebot-o1cr-open-contract"></block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_negate" id="freebot-o1cr-trade-limit-ok">
                    <value name="BOOL">
                      <block type="bot_trade_limit_reached" id="freebot-o1cr-trade-limit">
                        <value name="LIMIT">
                          <shadow type="math_number" id="freebot-o1cr-trade-limit-value">
                            <field name="NUM">250</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="digits_cold_run_recovery" id="freebot-o1cr-cold-run-recovery">
            <field name="PRIMARY">over_1</field>
            <field name="PERCENT">10.2</field>
            <field name="SAMPLE">1000</field>
            <field name="PARITY">both</field>
            <field name="REVERSAL">2</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="notify" id="freebot-o1cr-session-wait-notify">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="freebot-o1cr-session-wait-notify-text">
                <field name="TEXT">Waiting · session guard</field>
              </shadow>
            </value>
          </block>
        </statement>
      </block>
      </statement>
      </block>
    </statement>
  </block>
  
  <block type="after_purchase" id="freebot-o1cr-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-o1cr-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-o1cr-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-o1cr-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-o1cr-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-o1cr-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-o1cr-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="freebot-o1cr-take-profit"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="freebot-o1cr-take-profit-compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-o1cr-read-profit-for-tp">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="freebot-o1cr-take-profit-value">
                        <field name="NUM">10</field>
                      </shadow><block type="variables_get" id="freebot-o1cr-read-take-profit"><field name="VAR" id="freebot-take-profit" variabletype="">freebot:take-profit</field></block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="sweet_alert" id="freebot-o1cr-sweet-take-profit">
                    <field name="ALERT_ICON">success</field>
                    <value name="TITLE">
                      <shadow type="text"><field name="TEXT">Take profit reached</field></shadow>
                    </value>
                    <value name="MESSAGE">
                      <shadow type="text"><field name="TEXT">The bot stopped trading at its take profit target.</field></shadow>
                    </value>
                    <next>
                  <block type="variables_set" id="freebot-o1cr-stop-on-profit">
                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="freebot-o1cr-stop-on-profit-value">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="freebot-o1cr-stop-loss"><mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-o1cr-stop-loss-compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-o1cr-read-profit-for-sl">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="freebot-o1cr-stop-loss-value">
                            <field name="NUM">-20</field>
                          </shadow><block type="variables_get" id="freebot-o1cr-read-stop-loss"><field name="VAR" id="freebot-stop-loss" variabletype="">freebot:stop-loss</field></block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="sweet_alert" id="freebot-o1cr-sweet-stop-loss">
                        <field name="ALERT_ICON">error</field>
                        <value name="TITLE">
                          <shadow type="text"><field name="TEXT">Stop loss reached</field></shadow>
                        </value>
                        <value name="MESSAGE">
                          <shadow type="text"><field name="TEXT">The bot stopped trading at its stop loss limit.</field></shadow>
                        </value>
                        <next>
                      <block type="variables_set" id="freebot-o1cr-stop-on-loss">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-o1cr-stop-on-loss-value">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-o1cr-stake-step">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="variables_get" id="freebot-o1cr-read-won">
                            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-o1cr-reset-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="variables_get" id="freebot-o1cr-read-reset-stake"><field name="VAR" id="freebot-reset-stake" variabletype="">freebot:reset-stake</field></block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="freebot-o1cr-multiply-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="freebot-o1cr-stake-multiplier">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-o1cr-read-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-o1cr-multiplier-value">
                                    <field name="NUM">1.5</field>
                                  </shadow><block type="variables_get" id="freebot-o1cr-read-multiplier"><field name="VAR" id="freebot-multiplier" variabletype="">freebot:multiplier</field></block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-o1cr-rescan-after-loss">
                                <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="freebot-o1cr-rescan-after-loss-value">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-o1cr-trade-again">
                            <value name="IF0">
                              <block type="logic_negate" id="freebot-o1cr-not-stopped">
                                <value name="BOOL">
                                  <block type="variables_get" id="freebot-o1cr-read-stop">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                                <block type="report_journal" id="freebot-o1cr-result-report">
                                  <field name="LEVEL">info</field>
                                  <value name="MESSAGE">
                                    <shadow type="text" id="freebot-o1cr-result-report-text">
                                      <field name="TEXT">Result</field>
                                    </shadow>
                                    <block type="exec_last_result" id="freebot-o1cr-result-report-value"></block>
                                  </value>
                                  <next>
                                    <block type="report_journal" id="freebot-o1cr-session-report">
                                      <field name="LEVEL">info</field>
                                      <value name="MESSAGE">
                                        <shadow type="text" id="freebot-o1cr-session-report-text">
                                          <field name="TEXT">Session report</field>
                                        </shadow>
                                        <block type="report_session" id="freebot-o1cr-session-report-value"></block>
                                      </value>
                                      <next>
                                        <block type="trade_again" id="freebot-o1cr-trade-again-block"></block>
                                      </next>
                                    </block>
                                  </next>
                                </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
