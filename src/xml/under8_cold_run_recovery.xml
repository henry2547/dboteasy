<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-notice" islocal="false" iscloud="false">freebot:notice</variable>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-market-scanned" islocal="false" iscloud="false">freebot:market-scanned</variable>
  </variables>
  <block type="trade_definition" id="freebot-u8cr-definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-u8cr-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-u8cr-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-u8cr-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-u8cr-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-u8cr-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-u8cr-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="controls_if" id="freebot-u8cr-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-u8cr-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-u8cr-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-u8cr-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-u8cr-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-u8cr-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-u8cr-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-u8cr-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-u8cr-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-u8cr-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-u8cr-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                        <next>
                          <block type="risk_set_limits" id="freebot-u8cr-risk-limits">
                            <field name="MAX_LOSSES">6</field>
                            <field name="MAX_GIVE_BACK">0</field>
                            <field name="MAX_EXPOSURE">0</field>
                            <field name="RISK_PERCENT">0</field>
                            <next>
                              <block type="risk_reset_session" id="freebot-u8cr-risk-reset">
                                <next>
                                  <block type="learn_set_strategy" id="freebot-u8cr-learn-strategy">
                                    <field name="NAME">Under 8 — Cold 8/9 Run Recovery</field>
                                    <next>
                                      <block type="market_discover_eligible" id="freebot-u8cr-market-discover">
                                        <field name="CATEGORY">1-Second Volatility Indices</field>
                                        <field name="VERIFY">no</field>
                                        <value name="MIN_HISTORY">
                                          <shadow type="math_number" id="freebot-u8cr-market-history">
                                            <field name="NUM">20</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-u8cr-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-u8cr-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-u8cr-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-u8cr-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-u8cr-before-purchase" x="0" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-u8cr-session-guard"><mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="freebot-u8cr-session-guard-and">
            <field name="OP">AND</field>
            <value name="A">
              <block type="risk_can_trade" id="freebot-u8cr-risk-guard"></block>
            </value>
            <value name="B">
              <block type="logic_operation" id="freebot-u8cr-session-guard-execution">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_negate" id="freebot-u8cr-no-open-contract">
                    <value name="BOOL">
                      <block type="exec_has_open_contract" id="freebot-u8cr-open-contract"></block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_negate" id="freebot-u8cr-trade-limit-ok">
                    <value name="BOOL">
                      <block type="bot_trade_limit_reached" id="freebot-u8cr-trade-limit">
                        <value name="LIMIT">
                          <shadow type="math_number" id="freebot-u8cr-trade-limit-value">
                            <field name="NUM">250</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="digits_cold_run_recovery" id="freebot-u8cr-cold-run-recovery">
            <field name="PRIMARY">under_8</field>
            <field name="RUN">3</field>
            <field name="PERCENT">10.2</field>
            <field name="SAMPLE">100</field>
            <field name="PARITY">both</field>
            <field name="REVERSAL">2</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="notify" id="freebot-u8cr-session-wait-notify">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="freebot-u8cr-session-wait-notify-text">
                <field name="TEXT">Waiting · session guard</field>
              </shadow>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  
  <block type="after_purchase" id="freebot-u8cr-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-u8cr-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-u8cr-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-u8cr-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-u8cr-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-u8cr-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-u8cr-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="freebot-u8cr-take-profit"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="freebot-u8cr-take-profit-compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-u8cr-read-profit-for-tp">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="freebot-u8cr-take-profit-value">
                        <field name="NUM">10</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="freebot-u8cr-stop-on-profit">
                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="freebot-u8cr-stop-on-profit-value">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="freebot-u8cr-stop-loss"><mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-u8cr-stop-loss-compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-u8cr-read-profit-for-sl">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="freebot-u8cr-stop-loss-value">
                            <field name="NUM">-20</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="freebot-u8cr-stop-on-loss">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-u8cr-stop-on-loss-value">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-u8cr-stake-step">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="variables_get" id="freebot-u8cr-read-won">
                            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-u8cr-reset-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_number" id="freebot-u8cr-reset-stake-value">
                                <field name="NUM">10</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="freebot-u8cr-multiply-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="freebot-u8cr-stake-multiplier">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-u8cr-read-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-u8cr-multiplier-value">
                                    <field name="NUM">1.5</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-u8cr-rescan-after-loss">
                                <field name="VAR" id="freebot-market-scanned" variabletype="">freebot:market-scanned</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="freebot-u8cr-rescan-after-loss-value">
                                    <field name="BOOL">FALSE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-u8cr-trade-again">
                            <value name="IF0">
                              <block type="logic_negate" id="freebot-u8cr-not-stopped">
                                <value name="BOOL">
                                  <block type="variables_get" id="freebot-u8cr-read-stop">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                                <block type="report_journal" id="freebot-u8cr-result-report">
                                  <field name="LEVEL">info</field>
                                  <value name="MESSAGE">
                                    <shadow type="text" id="freebot-u8cr-result-report-text">
                                      <field name="TEXT">Result</field>
                                    </shadow>
                                    <block type="exec_last_result" id="freebot-u8cr-result-report-value"></block>
                                  </value>
                                  <next>
                                    <block type="report_journal" id="freebot-u8cr-session-report">
                                      <field name="LEVEL">info</field>
                                      <value name="MESSAGE">
                                        <shadow type="text" id="freebot-u8cr-session-report-text">
                                          <field name="TEXT">Session report</field>
                                        </shadow>
                                        <block type="report_session" id="freebot-u8cr-session-report-value"></block>
                                      </value>
                                      <next>
                                        <block type="trade_again" id="freebot-u8cr-trade-again-block"></block>
                                      </next>
                                    </block>
                                  </next>
                                </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
