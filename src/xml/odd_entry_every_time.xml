<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
  </variables>
  <block type="trade_definition" id="freebot-odd-definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-odd-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-odd-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-odd-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITODD</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-odd-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-odd-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-odd-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-odd-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-odd-duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-odd-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-odd-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-odd-before-purchase" x="0" y="740">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="freebot-odd-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-odd-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-odd-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-odd-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-odd-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-odd-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-odd-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-odd-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-odd-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-odd-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-odd-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="freebot-odd-entry">
            <value name="IF0">
              <block type="digits_even_odd" id="freebot-odd-entry-parity">
                <field name="PARITY">odd</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="purchase" id="freebot-odd-purchase">
                <field name="PURCHASE_LIST">DIGITODD</field>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="freebot-odd-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-odd-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-odd-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-odd-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-odd-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-odd-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-odd-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="freebot-odd-take-profit">
                <value name="IF0">
                  <block type="logic_compare" id="freebot-odd-take-profit-compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="freebot-odd-read-profit-for-tp">
                        <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="freebot-odd-take-profit-value">
                        <field name="NUM">10</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="freebot-odd-stop-on-profit">
                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="freebot-odd-stop-on-profit-value">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="freebot-odd-stop-loss">
                    <value name="IF0">
                      <block type="logic_compare" id="freebot-odd-stop-loss-compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="freebot-odd-read-profit-for-sl">
                            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="freebot-odd-stop-loss-value">
                            <field name="NUM">-20</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="freebot-odd-stop-on-loss">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-odd-stop-on-loss-value">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="freebot-odd-stake-step">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="variables_get" id="freebot-odd-read-won">
                            <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="freebot-odd-reset-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_number" id="freebot-odd-reset-stake-value">
                                <field name="NUM">10</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="freebot-odd-multiply-stake">
                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="freebot-odd-stake-multiplier">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-odd-read-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-odd-multiplier-value">
                                    <field name="NUM">1.5</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-odd-trade-again">
                            <value name="IF0">
                              <block type="logic_negate" id="freebot-odd-not-stopped">
                                <value name="BOOL">
                                  <block type="variables_get" id="freebot-odd-read-stop">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="trade_again" id="freebot-odd-trade-again-block"></block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
