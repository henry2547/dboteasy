<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="freebot-stake" islocal="false" iscloud="false">freebot:stake</variable>
    <variable type="" id="freebot-profit" islocal="false" iscloud="false">freebot:profit</variable>
    <variable type="" id="freebot-won" islocal="false" iscloud="false">freebot:won</variable>
    <variable type="" id="freebot-stop" islocal="false" iscloud="false">freebot:stop</variable>
    <variable type="" id="freebot-initialised" islocal="false" iscloud="false">freebot:initialised</variable>
    <variable type="" id="freebot-take-profit" islocal="false" iscloud="false">freebot:take-profit</variable>
    <variable type="" id="freebot-stop-loss" islocal="false" iscloud="false">freebot:stop-loss</variable>
    <variable type="" id="freebot-reset-stake" islocal="false" iscloud="false">freebot:reset-stake</variable>
    <variable type="" id="freebot-multiplier" islocal="false" iscloud="false">freebot:multiplier</variable>
    <variable type="" id="freebot-average" islocal="false" iscloud="false">freebot:average</variable>
  </variables>
  <block type="trade_definition" id="freebot-rf-definition" x="0" y="0">
    <field name="MODE_LIST">CONTINUOUS</field>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="freebot-rf-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="freebot-rf-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="freebot-rf-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="freebot-rf-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="freebot-rf-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="freebot-rf-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="controls_if" id="freebot-rf-init">
        <value name="IF0">
          <block type="logic_negate" id="freebot-rf-not-initialised">
            <value name="BOOL">
              <block type="variables_get" id="freebot-rf-read-initialised">
                <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="freebot-rf-set-initialised">
            <field name="VAR" id="freebot-initialised" variabletype="">freebot:initialised</field>
            <value name="VALUE">
              <block type="logic_boolean" id="freebot-rf-initialised-true">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="freebot-rf-set-stake">
                <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                <value name="VALUE">
                  <block type="math_number" id="freebot-rf-base-stake">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="freebot-rf-set-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="freebot-rf-zero-profit">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="freebot-rf-set-stop">
                        <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="freebot-rf-stop-off">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="freebot-rf-set-take-profit">
                            <field name="VAR" id="freebot-take-profit" variabletype="">freebot:take-profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="freebot-rf-num-take-profit">
                                <field name="NUM">10</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-rf-set-stop-loss">
                                <field name="VAR" id="freebot-stop-loss" variabletype="">freebot:stop-loss</field>
                                <value name="VALUE">
                                  <block type="math_number" id="freebot-rf-num-stop-loss">
                                    <field name="NUM">-20</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="freebot-rf-set-reset-stake">
                                    <field name="VAR" id="freebot-reset-stake" variabletype="">freebot:reset-stake</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="freebot-rf-num-reset-stake">
                                        <field name="NUM">10</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="freebot-rf-set-multiplier">
                                        <field name="VAR" id="freebot-multiplier" variabletype="">freebot:multiplier</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="freebot-rf-num-multiplier">
                                            <field name="NUM">2</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="risk_set_limits" id="freebot-rf-risk-limits">
                                            <field name="MAX_LOSSES">6</field>
                                            <field name="MAX_GIVE_BACK">0</field>
                                            <field name="MAX_EXPOSURE">0</field>
                                            <field name="RISK_PERCENT">0</field>
                                            <next>
                                              <block type="risk_reset_session" id="freebot-rf-risk-reset">
                                                <next>
                                                  <block type="learn_set_strategy" id="freebot-rf-learn-strategy">
                                                    <field name="NAME">Rise/Fall — 5-tick trend</field>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="freebot-rf-tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="freebot-rf-duration">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="freebot-rf-initial-stake">
            <field name="NUM">10</field>
          </shadow>
          <block type="variables_get" id="freebot-rf-stake">
            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
          </block>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="freebot-rf-before-purchase" x="0" y="740">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="sma_statement" id="freebot-rf-average">
        <field name="VARIABLE" id="freebot-average" variabletype="">freebot:average</field>
        <statement name="STATEMENT">
          <block type="input_list" id="freebot-rf-average-input" deletable="false" movable="false">
            <value name="INPUT_LIST">
              <block type="ticks" id="freebot-rf-average-ticks"></block>
            </value>
            <next>
              <block type="period" id="freebot-rf-average-period" deletable="false" movable="false">
                <value name="PERIOD">
                  <shadow type="math_number" id="freebot-rf-average-period-value">
                    <field name="NUM">5</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="freebot-rf-rise"><mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="freebot-rf-rise-guards">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="freebot-rf-rise-compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="tick" id="freebot-rf-rise-tick"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="freebot-rf-rise-average-read">
                        <field name="VAR" id="freebot-average" variabletype="">freebot:average</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_operation" id="freebot-rf-rise-session">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="risk_can_trade" id="freebot-rf-rise-risk"></block>
                    </value>
                    <value name="B">
                      <block type="logic_operation" id="freebot-rf-rise-execution">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_negate" id="freebot-rf-rise-no-contract">
                            <value name="BOOL">
                              <block type="exec_has_open_contract" id="freebot-rf-rise-open-contract"></block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_negate" id="freebot-rf-rise-limit-ok">
                            <value name="BOOL">
                              <block type="bot_trade_limit_reached" id="freebot-rf-rise-trade-limit">
                                <value name="LIMIT">
                                  <shadow type="math_number" id="freebot-rf-rise-trade-limit-value">
                                    <field name="NUM">250</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="freebot-rf-rise-notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="freebot-rf-rise-notify-text">
                    <field name="TEXT">Confirmed · last tick is above its 5-tick average — buying Rise (CALL)</field>
                  </shadow>
                </value>
                <next>
                  <block type="purchase" id="freebot-rf-rise-purchase">
                    <field name="PURCHASE_LIST">CALL</field>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="controls_if" id="freebot-rf-fall"><mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_operation" id="freebot-rf-fall-guards">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="freebot-rf-fall-compare">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="tick" id="freebot-rf-fall-tick"></block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="freebot-rf-fall-average-read">
                            <field name="VAR" id="freebot-average" variabletype="">freebot:average</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_operation" id="freebot-rf-fall-session">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="risk_can_trade" id="freebot-rf-fall-risk"></block>
                        </value>
                        <value name="B">
                          <block type="logic_operation" id="freebot-rf-fall-execution">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="logic_negate" id="freebot-rf-fall-no-contract">
                                <value name="BOOL">
                                  <block type="exec_has_open_contract" id="freebot-rf-fall-open-contract"></block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_negate" id="freebot-rf-fall-limit-ok">
                                <value name="BOOL">
                                  <block type="bot_trade_limit_reached" id="freebot-rf-fall-trade-limit">
                                    <value name="LIMIT">
                                      <shadow type="math_number" id="freebot-rf-fall-trade-limit-value">
                                        <field name="NUM">250</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="freebot-rf-fall-notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="freebot-rf-fall-notify-text">
                        <field name="TEXT">Confirmed · last tick is below its 5-tick average — buying Fall (PUT)</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="purchase" id="freebot-rf-fall-purchase">
                        <field name="PURCHASE_LIST">PUT</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="freebot-rf-wait-notify">
                    <field name="NOTIFICATION_TYPE">info</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="freebot-rf-wait-notify-text">
                        <field name="TEXT">Waiting · the last tick equals its 5-tick average</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="freebot-rf-after-purchase" x="720" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="freebot-rf-set-won">
        <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
        <value name="VALUE">
          <block type="contract_check_result" id="freebot-rf-check-win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="freebot-rf-add-profit">
            <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="freebot-rf-profit-sum">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="freebot-rf-read-profit">
                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="read_details" id="freebot-rf-contract-profit">
                    <field name="DETAIL_INDEX">4</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="report_journal" id="freebot-rf-result-report">
                <field name="LEVEL">info</field>
                <value name="MESSAGE">
                  <shadow type="text" id="freebot-rf-result-report-text">
                    <field name="TEXT">Result</field>
                  </shadow>
                  <block type="exec_last_result" id="freebot-rf-result-report-value"></block>
                </value>
                <next>
                  <block type="report_journal" id="freebot-rf-session-report">
                    <field name="LEVEL">info</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="freebot-rf-session-report-text">
                        <field name="TEXT">Session report</field>
                      </shadow>
                      <block type="report_session" id="freebot-rf-session-report-value"></block>
                    </value>
                    <next>
                      <block type="controls_if" id="freebot-rf-take-profit"><mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="freebot-rf-take-profit-compare">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get" id="freebot-rf-read-profit-for-tp">
                                <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number" id="freebot-rf-take-profit-value">
                                <field name="NUM">10</field>
                              </shadow>
                              <block type="variables_get" id="freebot-rf-read-take-profit">
                                <field name="VAR" id="freebot-take-profit" variabletype="">freebot:take-profit</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="sweet_alert" id="freebot-rf-sweet-take-profit">
                            <field name="ALERT_ICON">success</field>
                            <value name="TITLE">
                              <shadow type="text"><field name="TEXT">Take profit reached</field></shadow>
                            </value>
                            <value name="MESSAGE">
                              <shadow type="text"><field name="TEXT">The bot stopped trading at its take profit target.</field></shadow>
                            </value>
                            <next>
                              <block type="variables_set" id="freebot-rf-stop-on-profit">
                                <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="freebot-rf-stop-on-profit-value">
                                    <field name="BOOL">TRUE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="freebot-rf-stop-loss"><mutation else="1"></mutation>
                            <value name="IF0">
                              <block type="logic_compare" id="freebot-rf-stop-loss-compare">
                                <field name="OP">LTE</field>
                                <value name="A">
                                  <block type="variables_get" id="freebot-rf-read-profit-for-sl">
                                    <field name="VAR" id="freebot-profit" variabletype="">freebot:profit</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="freebot-rf-stop-loss-value">
                                    <field name="NUM">-20</field>
                                  </shadow>
                                  <block type="variables_get" id="freebot-rf-read-stop-loss">
                                    <field name="VAR" id="freebot-stop-loss" variabletype="">freebot:stop-loss</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="sweet_alert" id="freebot-rf-sweet-stop-loss">
                                <field name="ALERT_ICON">error</field>
                                <value name="TITLE">
                                  <shadow type="text"><field name="TEXT">Stop loss reached</field></shadow>
                                </value>
                                <value name="MESSAGE">
                                  <shadow type="text"><field name="TEXT">The bot stopped trading at its stop loss limit.</field></shadow>
                                </value>
                                <next>
                                  <block type="variables_set" id="freebot-rf-stop-on-loss">
                                    <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                    <value name="VALUE">
                                      <block type="logic_boolean" id="freebot-rf-stop-on-loss-value">
                                        <field name="BOOL">TRUE</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if" id="freebot-rf-stake-step"><mutation else="1"></mutation>
                                <value name="IF0">
                                  <block type="variables_get" id="freebot-rf-read-won">
                                    <field name="VAR" id="freebot-won" variabletype="">freebot:won</field>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set" id="freebot-rf-reset-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                    <value name="VALUE">
                                      <block type="variables_get" id="freebot-rf-read-reset-stake">
                                        <field name="VAR" id="freebot-reset-stake" variabletype="">freebot:reset-stake</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="ELSE">
                                  <block type="variables_set" id="freebot-rf-multiply-stake">
                                    <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic" id="freebot-rf-stake-multiplier">
                                        <field name="OP">MULTIPLY</field>
                                        <value name="A">
                                          <block type="variables_get" id="freebot-rf-read-stake">
                                            <field name="VAR" id="freebot-stake" variabletype="">freebot:stake</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number" id="freebot-rf-multiplier-value">
                                            <field name="NUM">2</field>
                                          </shadow>
                                          <block type="variables_get" id="freebot-rf-read-multiplier">
                                            <field name="VAR" id="freebot-multiplier" variabletype="">freebot:multiplier</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="controls_if" id="freebot-rf-trade-again">
                                    <value name="IF0">
                                      <block type="logic_negate" id="freebot-rf-not-stopped">
                                        <value name="BOOL">
                                          <block type="variables_get" id="freebot-rf-read-stop">
                                            <field name="VAR" id="freebot-stop" variabletype="">freebot:stop</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="trade_again" id="freebot-rf-trade-again-block"></block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
